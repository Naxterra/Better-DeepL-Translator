<Application x:Class="NaxDeepL.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- StartupUri omitted — startup handled in App.xaml.cs -->
    <Application.Resources>

        <!-- ── Colours (dark, made for OLED screens) ──
             The window is true black and every surface is a solid colour. Large faint gradients
             show visible steps near black on OLED panels, so colour comes only from the accent. -->
        <SolidColorBrush x:Key="BgWindow"        Color="#000000"/>
        <SolidColorBrush x:Key="CardFill"        Color="#0C0C0E"/>
        <SolidColorBrush x:Key="CardFillAlt"     Color="#08080A"/>
        <SolidColorBrush x:Key="CardStroke"      Color="#232328"/>
        <SolidColorBrush x:Key="ControlFill"     Color="#141417"/>
        <SolidColorBrush x:Key="ControlHover"    Color="#202025"/>
        <SolidColorBrush x:Key="ControlPressed"  Color="#0E0E10"/>
        <SolidColorBrush x:Key="ControlStroke"   Color="#2A2A30"/>
        <SolidColorBrush x:Key="FlyoutFill"      Color="#16161A"/>
        <SolidColorBrush x:Key="Accent"          Color="#60CDFF"/>
        <SolidColorBrush x:Key="AccentHover"     Color="#E660CDFF"/>
        <SolidColorBrush x:Key="AccentPressed"   Color="#CC60CDFF"/>
        <SolidColorBrush x:Key="OnAccent"        Color="#000000"/>
        <SolidColorBrush x:Key="Success"         Color="#6CCB5F"/>
        <SolidColorBrush x:Key="SuccessFill"     Color="#226CCB5F"/>
        <SolidColorBrush x:Key="FgMain"          Color="#FFFFFF"/>
        <SolidColorBrush x:Key="FgSecondary"     Color="#C5FFFFFF"/>
        <SolidColorBrush x:Key="FgMuted"         Color="#87FFFFFF"/>

        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <!-- ── Accent button ── -->
        <Style TargetType="Button">
            <Setter Property="Background"  Value="{StaticResource Accent}"/>
            <Setter Property="Foreground"  Value="{StaticResource OnAccent}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"     Value="12,6"/>
            <Setter Property="FontSize"    Value="13"/>
            <Setter Property="Cursor"      Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentHover}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentPressed}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Standard button: translucent fill with a thin outline -->
        <Style x:Key="StdBtn" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background"  Value="{StaticResource ControlFill}"/>
            <Setter Property="Foreground"  Value="{StaticResource FgMain}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ControlStroke}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource ControlHover}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{StaticResource ControlPressed}"/>
                    <Setter Property="Foreground" Value="{StaticResource FgSecondary}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Subtle button: no fill until the mouse is over it -->
        <Style x:Key="SubtleBtn" TargetType="Button" BasedOn="{StaticResource StdBtn}">
            <Setter Property="Background"  Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground"  Value="{StaticResource FgSecondary}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource ControlHover}"/>
                    <Setter Property="Foreground" Value="{StaticResource FgMain}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Round icon button, used for swapping the languages -->
        <Style x:Key="RoundBtn" TargetType="Button" BasedOn="{StaticResource StdBtn}">
            <Setter Property="Width"      Value="36"/>
            <Setter Property="Height"     Value="36"/>
            <Setter Property="Padding"    Value="0"/>
            <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
            <Setter Property="FontSize"   Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="18">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Segmented control: a pill holding RadioButtons ── -->
        <Style x:Key="SegGroup" TargetType="Border">
            <Setter Property="Background"      Value="{StaticResource ControlFill}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource ControlStroke}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="6"/>
            <Setter Property="Padding"         Value="2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="SegBtn" TargetType="RadioButton">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{StaticResource FgSecondary}"/>
            <Setter Property="Padding"         Value="12,4"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource ControlHover}"/>
                    <Setter Property="Foreground" Value="{StaticResource FgMain}"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="{StaticResource Accent}"/>
                    <Setter Property="Foreground" Value="{StaticResource OnAccent}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ── Cards around the two text areas ── -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background"      Value="{StaticResource CardFill}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource CardStroke}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="10"/>
        </Style>

        <!-- The input card shows an accent outline while the text box has the focus -->
        <Style x:Key="InputCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ── TextBox: borderless, it sits inside a card ── -->
        <Style TargetType="TextBox">
            <Setter Property="Background"  Value="Transparent"/>
            <Setter Property="Foreground"  Value="{StaticResource FgMain}"/>
            <Setter Property="CaretBrush"  Value="{StaticResource Accent}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"     Value="16,14"/>
            <Setter Property="FontSize"    Value="15"/>
            <Setter Property="FontFamily"  Value="Segoe UI Variable Text, Segoe UI"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="SelectionBrush" Value="{StaticResource Accent}"/>
            <Setter Property="SelectionOpacity" Value="0.45"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── ComboBox ── -->
        <Style TargetType="ComboBox">
            <Setter Property="Background"  Value="{StaticResource ControlFill}"/>
            <Setter Property="Foreground"  Value="{StaticResource FgMain}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ControlStroke}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"     Value="12,0,4,0"/>
            <Setter Property="Height"      Value="36"/>
            <Setter Property="FontSize"    Value="13"/>
            <Setter Property="Cursor"      Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="Toggle"
                                IsChecked="{Binding IsDropDownOpen,
                                    RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                Focusable="False" ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Bd"
                                            Background="{Binding Background,
                                                RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                            BorderBrush="{Binding BorderBrush,
                                                RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                            BorderThickness="{Binding BorderThickness,
                                                RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                            CornerRadius="4">
                                            <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}"
                                                       FontSize="10" Foreground="{StaticResource FgSecondary}"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                                       Margin="0,0,12,0"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background"
                                                        Value="{StaticResource ControlHover}"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush"
                                                        Value="{StaticResource Accent}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter
                                Content="{TemplateBinding SelectionBoxItem}"
                                ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                Margin="{TemplateBinding Padding}"
                                VerticalAlignment="Center" IsHitTestVisible="False"/>
                            <Popup x:Name="PART_Popup" AllowsTransparency="True"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom" VerticalOffset="4" Focusable="False"
                                   PopupAnimation="Fade">
                                <Border Background="{StaticResource FlyoutFill}"
                                        BorderBrush="{StaticResource CardStroke}"
                                        BorderThickness="1" CornerRadius="8" Padding="4"
                                        Margin="0,0,10,12"
                                        MinWidth="{Binding ActualWidth,
                                            RelativeSource={RelativeSource TemplatedParent}}">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="16" Opacity="0.45"
                                                          ShadowDepth="6" Direction="270"
                                                          Color="Black"/>
                                    </Border.Effect>
                                    <ScrollViewer CanContentScroll="True" MaxHeight="280"
                                                  Background="Transparent">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="{StaticResource FgMain}"/>
                        <Setter Property="Padding"    Value="12,8"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="4"
                                            Margin="0,1">
                                        <Grid>
                                            <!-- Fluent selection marker on the left edge -->
                                            <Border x:Name="Marker" Width="3" Height="16" CornerRadius="1.5"
                                                    Background="{StaticResource Accent}"
                                                    HorizontalAlignment="Left" Visibility="Collapsed"/>
                                            <ContentPresenter Margin="{TemplateBinding Padding}"/>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background"
                                                    Value="{StaticResource ControlHover}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background"
                                                    Value="{StaticResource ControlFill}"/>
                                            <Setter TargetName="Marker" Property="Visibility" Value="Visible"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Context menu flyout ── -->
        <Style x:Key="FlyoutMenu" TargetType="ContextMenu">
            <Setter Property="Background"      Value="{StaticResource FlyoutFill}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource CardStroke}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="4"/>
            <!-- Keeps the popup transparent, so the rounded corners and the shadow below show. -->
            <Setter Property="HasDropShadow"   Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <!-- The outer margin leaves room for the shadow inside the popup. -->
                        <Border Margin="0,0,10,12" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}"
                                MinWidth="200" SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16" Opacity="0.45" ShadowDepth="6"
                                                  Direction="270" Color="Black"/>
                            </Border.Effect>
                            <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Resources>
                <Style TargetType="MenuItem">
                    <Setter Property="Background"  Value="Transparent"/>
                    <Setter Property="Foreground"  Value="{StaticResource FgMain}"/>
                    <Setter Property="FontSize"    Value="13"/>
                    <Setter Property="Cursor"      Value="Hand"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="MenuItem">
                                <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                        CornerRadius="4" Margin="0,1">
                                    <Grid Margin="10,7">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="22"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="Check" Grid.Column="0" Text="&#xE73E;"
                                                   FontFamily="{StaticResource IconFont}" FontSize="12"
                                                   Foreground="{StaticResource Accent}"
                                                   VerticalAlignment="Center" HorizontalAlignment="Left"
                                                   Visibility="Hidden"/>
                                        <ContentPresenter Grid.Column="1" ContentSource="Header"
                                                          VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsHighlighted" Value="True">
                                        <Setter TargetName="Bd" Property="Background"
                                                Value="{StaticResource ControlHover}"/>
                                    </Trigger>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
                <!-- Menus look up their separator style under this key, not by type. -->
                <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Separator">
                                <Rectangle Height="1" Fill="{StaticResource CardStroke}" Margin="4,4"/>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Style.Resources>
        </Style>

        <!-- ── ScrollBar: a thin rounded thumb without arrow buttons ── -->
        <ControlTemplate x:Key="ThinThumb" TargetType="Thumb">
            <Border x:Name="T" Background="{StaticResource FgMuted}" CornerRadius="2"/>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="T" Property="Background" Value="{StaticResource FgSecondary}"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style TargetType="ScrollBar">
            <Setter Property="Width"    Value="10"/>
            <Setter Property="MinWidth" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="3,6">
                            <Track.Thumb>
                                <Thumb Template="{StaticResource ThinThumb}"/>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width"     Value="Auto"/>
                    <Setter Property="MinWidth"  Value="0"/>
                    <Setter Property="Height"    Value="10"/>
                    <Setter Property="MinHeight" Value="10"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Track x:Name="PART_Track" Margin="6,3">
                                    <Track.Thumb>
                                        <Thumb Template="{StaticResource ThinThumb}"/>
                                    </Track.Thumb>
                                </Track>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Application.Resources>
</Application>
