<Window x:Class="NaxDeepL.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nax-DeepL"
        Width="940" Height="560" MinWidth="640" MinHeight="400"
        Background="{StaticResource BgWindow}"
        Foreground="{StaticResource FgMain}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>   <!-- header -->
            <RowDefinition Height="Auto"/> <!-- lang selectors -->
            <RowDefinition Height="*"/>    <!-- text cards -->
            <RowDefinition Height="32"/>   <!-- status line -->
        </Grid.RowDefinitions>

        <!-- A soft blue to violet wash across the whole window, so it is not flat grey. -->
        <Rectangle Grid.RowSpan="4" IsHitTestVisible="False" Fill="{StaticResource WindowWash}"/>

        <!-- ═══ Header ═══ -->
        <Grid Grid.Row="0" Margin="20,0,16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- App icon, name and Pro badge -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="30" Height="30" CornerRadius="8" Margin="0,0,10,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#60CDFF" Offset="0"/>
                            <GradientStop Color="#3A7BFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <TextBlock Text="&#xF2B7;" FontFamily="{StaticResource IconFont}" FontSize="16"
                               Foreground="{StaticResource OnAccent}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock x:Name="TitleText" Text="Nax-DeepL"
                           FontFamily="Segoe UI Variable Display, Segoe UI"
                           FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Border x:Name="BadgePill" Margin="10,0,0,0" Padding="8,2" CornerRadius="10"
                        Background="{StaticResource SuccessFill}" VerticalAlignment="Center"
                        Visibility="Collapsed">
                    <TextBlock x:Name="Badge" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource Success}"/>
                </Border>
            </StackPanel>

            <!-- DE / EN interface language -->
            <Border Grid.Column="2" Style="{StaticResource SegGroup}" Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="LangDeRb" Content="DE" Style="{StaticResource SegBtn}"
                                 Checked="UiLang_Changed"/>
                    <RadioButton x:Name="LangEnRb" Content="EN" Style="{StaticResource SegBtn}"
                                 Checked="UiLang_Changed"/>
                </StackPanel>
            </Border>

            <!-- Engine -->
            <Border Grid.Column="3" Style="{StaticResource SegGroup}" Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="ClassicRb" Content="Classic" Style="{StaticResource SegBtn}"
                                 Checked="Engine_Changed"/>
                    <RadioButton x:Name="NextgenRb" Content="Next-gen" Style="{StaticResource SegBtn}"
                                 Checked="Engine_Changed"/>
                </StackPanel>
            </Border>

            <!-- Connection button, always opens the menu -->
            <Button x:Name="VerbindungBtn" Grid.Column="4" Style="{StaticResource StdBtn}"
                    Padding="10,6" VerticalAlignment="Center" Click="Verbindung_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="14"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock x:Name="ConnectLabel" Text="Verbindung" VerticalAlignment="Center"/>
                </StackPanel>
                <Button.ContextMenu>
                    <ContextMenu Style="{StaticResource FlyoutMenu}">
                        <MenuItem x:Name="MenuItemLogin"   Header="Anmelden"       Click="Login_Click"/>
                        <MenuItem x:Name="MenuItemSwitch"  Header="Konto wechseln" Click="SwitchAccount_Click"/>
                        <MenuItem x:Name="MenuItemLogout"  Header="Abmelden"       Click="Logout_Click"/>
                        <Separator/>
                        <MenuItem x:Name="MenuItemStartup" Header="Mit Windows starten"
                                  IsCheckable="True" Click="Startup_Click"/>
                        <Separator/>
                        <MenuItem x:Name="MenuItemAbout" Header="Über" Click="About_Click"/>
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>
        </Grid>

        <!-- ═══ Language bar ═══ -->
        <Grid Grid.Row="1" Margin="16,4,16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="56"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ComboBox x:Name="SrcCombo" Grid.Column="0" SelectionChanged="Lang_Changed"/>

            <Button Grid.Column="1" Content="&#xE8AB;" Style="{StaticResource RoundBtn}"
                    HorizontalAlignment="Center" Click="Swap_Click"/>

            <ComboBox x:Name="TgtCombo" Grid.Column="2" SelectionChanged="Lang_Changed"/>
        </Grid>

        <!-- ═══ Text cards ═══ -->
        <Grid Grid.Row="2" Margin="16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Source -->
            <Border Grid.Column="0" Style="{StaticResource InputCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBox x:Name="SrcBox"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             TextChanged="SrcBox_Changed"
                             KeyDown="SrcBox_KeyDown"/>
                    <Grid Grid.Row="1" Margin="12,0,8,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="CharCount" Text="0 / 5000" Margin="4,0,0,0"
                                   Foreground="{StaticResource FgMuted}" FontSize="12"
                                   VerticalAlignment="Center"/>
                        <Button x:Name="ClearBtn" Grid.Column="1" Style="{StaticResource SubtleBtn}"
                                Padding="10,5" Click="Clear_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock x:Name="ClearLabel" Text="Löschen" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </Border>

            <!-- Translation -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Background="{StaticResource CardFillAlt}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBox x:Name="TgtBox"
                             AcceptsReturn="True" TextWrapping="Wrap" IsReadOnly="True"
                             VerticalScrollBarVisibility="Auto"/>
                    <Button x:Name="CopyBtn" Grid.Row="1" HorizontalAlignment="Right"
                            Margin="0,0,8,8" Padding="12,5" Click="Copy_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8C8;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock x:Name="CopyLabel" Text="Kopieren" FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </Grid>

        <!-- ═══ Status line ═══ -->
        <TextBlock x:Name="StatusText" Grid.Row="3" Text="Bereit"
                   VerticalAlignment="Center" Margin="20,0"
                   Foreground="{StaticResource FgMuted}" FontSize="12"/>
    </Grid>
</Window>
